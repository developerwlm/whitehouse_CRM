# ========================================================
# WHITEHOUSE CRM – BACKEND ENVIRONMENT CONFIGURATION
# Whitehouse Skill Development Institute, Madurai
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=production
CLIENT_URL=https://crm.whitehouseinstitute.in

# Database Connection (Local MongoDB or MongoDB Atlas Cluster)
# For Hostinger VPS local: mongodb://127.0.0.1:27017/whitehouse_crm
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/whitehouse_crm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/whitehouse_crm

# JWT Security
JWT_SECRET=WHITEHOUSE_MADURAI_SUPER_SECRET_JWT_KEY_2026_PRODUCTION_GRADE
JWT_EXPIRE=30d

# Meta Lead Ads Integration (Graph API v21.0 & Webhooks)
META_APP_ID=827361928374619
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ID=109823471829381
META_PAGE_ACCESS_TOKEN=EAAGm0PX4ZCpsBAK...
META_WEBHOOK_VERIFY_TOKEN=WHITEHOUSE_CRM_META_VERIFY_TOKEN_2026

# Cloudinary Storage for Student Documents & Photos (Optional)
CLOUDINARY_CLOUD_NAME=whitehouse-madurai
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Institute Identity
INSTITUTE_NAME="Whitehouse Skill Development Institute"
INSTITUTE_CITY="Madurai"
INSTITUTE_STATE="Tamil Nadu"
INSTITUTE_PHONE="+91 98765 43210"
INSTITUTE_EMAIL="info@whitehouseinstitute.in"
